---
import Layout from "../layouts/Layout.astro";
import LinkedInIcon from "../components/icons/LinkedIn.astro";
import GithubIcon from "../components/icons/Github.astro";
import ResumeIcon from "../components/icons/Resume.astro";
import Social from "../components/Social.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Experience from "../components/MyExperience.astro";
import Stickers from "../components/experiences/Stickers.astro";
import Projects from "../components/Projects.astro";
import { defaultLang, useTranslations } from "../i18n/ui";

const t = useTranslations(defaultLang);
---

<Layout>
  <main class="mx-4">
    <SectionContainer
      class="flex min-h-dvh flex-col justify-center gap-4"
      id="home"
    >
      <h1
        class="text-4xl font-bold tracking-tight text-strong lg:text-6xl"
      >
        {t("hero.greeting")}
      </h1>
      <p class="max-w-[60ch] text-lg text-body lg:text-xl">
        {t("hero.bio")}
      </p>
      <div class="mt-2 flex flex-row flex-wrap gap-3">
        <Social
          url="https://www.linkedin.com/in/agustin-villar-4a9bab259/"
          title="LinkedIn"
        >
          <LinkedInIcon class="size-4" />
        </Social>
        <Social url="https://github.com/JAguVillar" title="GitHub">
          <GithubIcon class="size-4" />
        </Social>
      </div>
    </SectionContainer>

    <SectionContainer
      class="relative flex min-h-dvh flex-col justify-center"
      id="experiencia"
    >
      <Stickers />
      <div class="mb-8 flex items-center justify-between gap-4">
        <h2 class="text-3xl font-bold text-strong lg:text-4xl">
          {t("experience.title")}
        </h2>
        <Social url="/cv.pdf" title={t("hero.cv")}>
          <ResumeIcon class="size-4" />
        </Social>
      </div>
      <Experience />
    </SectionContainer>

    <SectionContainer class="flex min-h-dvh flex-col justify-center" id="proyectos">
      <h2 class="mb-8 text-3xl font-bold text-strong lg:text-4xl">
        {t("projects.title")}
      </h2>
      <Projects />
    </SectionContainer>
  </main>
</Layout>
