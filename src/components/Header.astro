---
import ThemeToggle from "./ThemeToggle.astro";
import { Image } from "astro:assets";
import ImagenPerfil from "../images/foto-perfil.jpg";
import { defaultLang, useTranslations } from "../i18n/ui";

const t = useTranslations(defaultLang);

const links = [
  { href: "#home", label: t("nav.home") },
  { href: "#experiencia", label: t("nav.experience") },
  { href: "#proyectos", label: t("nav.projects") },
];
---

<header
  class="fixed top-0 z-10 mx-auto grid w-full grid-cols-[1fr_auto_1fr] items-center px-4 py-5 lg:px-28"
>
  <Image
    src={ImagenPerfil}
    alt="Foto de Agustín Villar"
    class="col-start-1 hidden size-10 rounded-full lg:block"
  />

  <nav
    class="col-start-2 flex items-center justify-center gap-x-5 rounded-full px-6 py-2 text-sm font-semibold text-body transition lg:gap-x-8 lg:text-base"
  >
    {
      links.map((link) => (
        <a
          class="nav-link transition-colors duration-200 ease-in-out hover:text-accent"
          href={link.href}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="col-start-3 flex justify-end">
    <ThemeToggle
      class="grid size-9 place-items-center rounded-full bg-surface/50 text-muted ring-1 ring-line/50 backdrop-blur-lg transition duration-200 ease-in-out hover:text-accent"
    />
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll<HTMLElement>("main section");
    const navItems = document.querySelectorAll<HTMLAnchorElement>(
      "header nav a.nav-link",
    );

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navItems.forEach((item) => {
          const isActive = item.getAttribute("href") === `#${entry.target.id}`;
          item.classList.toggle("text-accent", isActive);
          item.setAttribute("aria-current", isActive ? "true" : "false");
        });
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.5,
    });

    sections.forEach((section) => observer.observe(section));
  });
</script>

<style>
  nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
    @apply bg-surface/50 dark:bg-surface/40;
  }

  @keyframes nav-shadow {
    0% {
      @apply bg-surface/0 ring-transparent;
    }
    to {
      @apply shadow-lg ring-1 ring-line/50 backdrop-blur-lg;
    }
  }

  img {
    animation: img-fade-out 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes img-fade-out {
    0% {
      @apply opacity-100;
    }
    to {
      @apply opacity-0;
    }
  }
</style>
