---
import ExperienceItem from "./experiences/Experience.astro";
import { experiences } from "../data/experiences";
import { defaultLang, useTranslations } from "../i18n/ui";

const lang = defaultLang;
const t = useTranslations(lang);
---

<ol class="relative ml-3 border-s border-line">
  {
    experiences.map((item) => (
      <ExperienceItem
        empresa={item.empresa}
        color={item.color}
        fecha={`${item.inicio} – ${item.fin ?? t("experience.present")}`}
        puesto={item.puesto[lang]}
        descripcion={item.descripcion[lang]}
      />
    ))
  }
</ol>
