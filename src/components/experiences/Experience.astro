---
interface Props {
  empresa: string;
  color: string;
  fecha: string;
  puesto: string;
  descripcion: string;
}

const { empresa, color, fecha, puesto, descripcion } = Astro.props;
---

<li class="mb-12 ms-6 grid gap-2 md:grid-cols-[1fr_1.4fr] md:gap-8">
  <div>
    <span
      class="absolute -start-[7px] mt-1.5 size-3.5 rounded-full border-2 border-bg"
      style={`background:${color};`}
      aria-hidden="true"></span>
    <p class="text-sm font-medium text-muted">{puesto}</p>
    <h3 class="text-xl font-bold" style={`color:${color};`}>@ {empresa}</h3>
    <time class="text-sm font-medium tabular-nums text-muted">{fecha}</time>
  </div>
  <p class="text-base text-body">{descripcion}</p>
</li>
