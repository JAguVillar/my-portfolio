---
import Social from "../components/Social.astro";
import { defaultLang, useTranslations } from "../i18n/ui";

const t = useTranslations(defaultLang);
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-16 flex w-full max-w-[768px] flex-col items-center justify-between gap-4 border-t border-line px-4 py-10 text-sm text-muted sm:flex-row">
  <p>© {year} Agustín Villar. {t("footer.rights")}</p>
  <Social url="mailto:jaguvillar@gmail.com" title={t("footer.contact")} />
</footer>
