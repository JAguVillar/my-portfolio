---
import { Image } from "astro:assets";
import Gato from "../images/cat.webp";
import { defaultLang, useTranslations } from "../i18n/ui";

const t = useTranslations(defaultLang);
---

<div class="flex flex-col items-center justify-center gap-6 py-12 text-center">
  <Image
    src={Gato}
    alt="Ilustración de un gato indicando que la sección está en construcción"
    class="w-32 rounded-full"
  />
  <p class="max-w-[40ch] text-xl font-semibold text-body">
    {t("projects.empty")}
  </p>
</div>
